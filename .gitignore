# The scans themselves: ~56 GB from the Internet Archive, re-fetchable and
# checksum-verified, so they have no business in git.
data/originals/
data/wallpapers/
data/desktop/

# Derived index, rebuilt from the CSV + the Archive's manifests by `pom db`.
data/*.sqlite
data/*.sqlite-wal
data/*.sqlite-shm

# The comparison page is a build artifact: half a megabyte of inlined base64.
# Rebuild with `python3 prototypes/build_desktop.py`.
prototypes/desktop.html
prototypes/treatments.html

logs/
result
__pycache__/
*.pyc

# NAL's metadata export. `pom db` downloads it from the Internet Archive, so
# shipping 3.9 MB of it would just be a stale copy.
data/pom_metadata.csv

# Mirror build output: 1.3 GB of tarballs, published as release assets by
# scripts/mirror.py rather than committed.
data/mirror/
data/mirror-dl/
